# Runtime mode
APP_ENV=development
LOG_LEVEL=INFO

# SQLite stays local and free. Use an absolute path in production.
DATABASE_URL=sqlite:///./finguard.db

# Comma-separated browser origins. Use the deployed HTTPS origin in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Optional Gemini context analysis. The core parser and risk engine work without it.
# Disabled by default. Set true only together with a monitored server-side key.
ENABLE_AI_CONTEXT=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12
MAX_SCREENSHOT_BYTES=2000000
ASSESSMENT_RETENTION_DAYS=30
# Anonymous assessments are bounded for the documented one-worker SQLite service.
MAX_ASSESSED_RECORDS_TOTAL=5000
MAX_ASSESSED_RECORDS_PER_DEVICE=50

# Account sessions. Generate AUTH_SECRET_KEY with at least 32 random characters.
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Bound public account rows on the documented single-node service.
MAX_REGISTERED_USERS=5000

# Optional Google OpenID Connect client IDs accepted by the backend.
# Include the Web client ID used as Android's server client ID.
GOOGLE_OAUTH_CLIENT_IDS=

# Optional spoken-guidance layer. Off unless ENABLE_VOICE_ASSIST is true and a
# key is set. When off, the app never offers a listen control and behaves
# exactly as it did before the layer existed.
ENABLE_VOICE_ASSIST=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=20
