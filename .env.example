# Runtime mode
APP_ENV=development
LOG_LEVEL=INFO

# SQLite stays local and free. Use an absolute path in production.
DATABASE_URL=sqlite:///./finguard.db

# Comma-separated browser origins. Use the deployed HTTPS origin in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional Gemini context analysis. The core parser and risk engine work without it.
ENABLE_AI_CONTEXT=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12
MAX_SCREENSHOT_BYTES=2000000
ASSESSMENT_RETENTION_DAYS=30

# Account sessions. Generate AUTH_SECRET_KEY with at least 32 random characters.
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional Google OpenID Connect client IDs accepted by the backend.
# Include the Web client ID used as Android's server client ID.
GOOGLE_OAUTH_CLIENT_IDS=
