# Copy to /etc/finguard/finguard.env and keep the real file off Git.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////var/lib/finguard/finguard.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ALLOWED_ORIGINS=https://finguard.example.dev
# Keep false unless a monitored provider budget or gateway is in place.
ENABLE_AI_CONTEXT=false
GEMINI_TIMEOUT_SECONDS=12
MAX_SCREENSHOT_BYTES=2000000
ASSESSMENT_RETENTION_DAYS=30
MAX_ASSESSED_RECORDS_TOTAL=5000
MAX_ASSESSED_RECORDS_PER_DEVICE=50
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_REGISTERED_USERS=5000
GOOGLE_OAUTH_CLIENT_IDS=
